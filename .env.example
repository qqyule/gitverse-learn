# GitMaster environment configuration
# Copy to `.env.local` and fill in to enable cloud features.
# Without these, the app runs in LOCAL mode (progress stored on-device only).

# --- M3: Supabase (cloud accounts + cross-device sync) ---
# Enable by: pnpm add @supabase/supabase-js
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- M5: Payments (charges default OFF — skeleton mode until keys set) ---
# Any one of these enables real checkout for that provider. With none set,
# the app runs in demo mode (local upgrade, no real charge).
VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_WECHAT_MCH_ID=
# VITE_ALIPAY_APP_ID=

# --- M6: Public API base URL (for the embeddable SDK) ---
VITE_API_BASE_URL=https://api.gitmaster.app
