{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["!!**/dist", "!!**/coverage", "!!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "off",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noImplicitAnyLet": "off",
        "noUnknownAtRules": "off",
        "noDocumentCookie": "off",
        "noReactForwardRef": "off",
        "noLeakedRender": "off",
        "noUnnecessaryConditions": "off",
        "noUnknownAttribute": "off",
        "noShadow": "off"
      },
      "a11y": {
        "useButtonType": "error",
        "noSvgWithoutTitle": "warn",
        "noRedundantAlt": "warn",
        "noLabelWithoutControl": "warn",
        "useSemanticElements": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useFocusableInteractive": "warn",
        "useAriaPropsForRole": "warn"
      },
      "complexity": {
        "noUselessFragments": "warn",
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off",
        "noJsxPropsBind": "off"
      },
      "style": {
        "useImportType": "warn",
        "useTemplate": "warn",
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off",
        "useFilenamingConvention": "off",
        "useBlockStatements": "off",
        "useConsistentTypeDefinitions": "off",
        "noExportedImports": "off",
        "useAtIndex": "off",
        "noNestedTernary": "off",
        "useDefaultSwitchClause": "off",
        "useConsistentBuiltinInstantiation": "off",
        "useDestructuring": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "tab",
      "indentWidth": 2
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsForRole": "off"
          }
        }
      }
    }
  ]
}
